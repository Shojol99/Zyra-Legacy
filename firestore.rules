rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Auth tokens NEVER contain custom claims. 
    // Check against a trusted collection for admin privileges.
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'ahamedshahjalal170@gmail.com' && isEmailVerified()
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidProduct(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.category is string &&
             data.images is list && data.images.size() > 0 &&
             data.keys().hasAll(['title', 'price', 'category', 'images']) &&
             data.keys().size() >= 4;
    }

    function isValidOrder(data) {
      return data.userId == request.auth.uid &&
             data.items is list && data.items.size() > 0 &&
             data.total is number && data.total >= 0 &&
             data.status in ['pending', 'processing', 'shipped', 'delivered', 'cancelled'] &&
             data.paymentMethod in ['cod', 'bkash', 'nagad', 'rocket'] &&
             data.customerDetails is map &&
             data.keys().hasAll(['userId', 'items', 'total', 'status', 'paymentMethod', 'customerDetails']);
    }

    function isValidReview(data) {
      return data.productId is string &&
             data.userId == request.auth.uid &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.comment is string && data.comment.size() <= 1000;
    }

    function isValidCoupon(data) {
      return data.code is string && data.code.size() <= 20 &&
             data.type in ['percent', 'fixed'] &&
             data.value is number && data.value > 0;
    }

    function isValidBlogPost(data) {
      return data.title is string && data.title.size() <= 300 &&
             data.slug is string &&
             data.content is string &&
             data.images is list &&
             data.keys().hasAll(['title', 'slug', 'content']);
    }

    // --- Match Blocks ---

    // Bootstrapped Admin Registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // System only
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() && isValidProduct(incoming()) && isValidId(productId);
      allow update: if isAdmin() && isValidProduct(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['title', 'price', 'stock', 'category', 'images', 'status', 'isFeatured', 'updatedAt', 'seo'])
      );
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(categoryId);
    }

    match /orders/{orderId} {
      allow get: if isOwner(existing().userId) || isAdmin();
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && isValidOrder(incoming()) && isValidId(orderId);
      allow update: if (
        isAdmin() || 
        (isOwner(existing().userId) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['status']) && 
         incoming().status == 'cancelled' && 
         existing().status == 'pending')
      );
      allow delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isEmailVerified() && isValidReview(incoming()) && isValidId(reviewId);
      allow update: if isAdmin() || (isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly(['comment', 'rating']));
      allow delete: if isAdmin() || isOwner(existing().userId);
    }

    match /blogPosts/{postId} {
      allow read: if true;
      allow write: if isAdmin() && isValidBlogPost(incoming()) && isValidId(postId);
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && incoming().role == 'user'; // Prevent self-admin
      allow update: if isOwner(userId) && !incoming().diff(existing()).affectedKeys().hasAny(['role']); // Prevent role escalation
      allow update: if isAdmin(); // Admins can manage roles
    }

    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() && isValidCoupon(incoming()) && isValidId(couponId);
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(settingId);
    }
  }
}
